# Generate distinct random values, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SOS_MASTER_SECRET=replace-with-a-unique-48-byte-base64url-secret
SOS_TOKEN_SECRET=replace-with-a-different-unique-48-byte-base64url-secret

# Docker binds loopback by default. Put a TLS reverse proxy in front before
# changing this to 0.0.0.0 for public Internet traffic.
SOS_BIND_ADDRESS=127.0.0.1
SOS_PORT=3000
SOS_WARD_BOUNDARIES_FILE=vn-wards-simplified.geojson
TRUST_PROXY=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
